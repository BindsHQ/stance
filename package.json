{
  "name": "stance-monorepo",
  "private": true,
  "description": "Stance, the official open-source design system by Binds.",
  "license": "Apache-2.0",
  "author": "Binds",
  "homepage": "https://www.stanceui.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BindsHQ/stance.git"
  },
  "bugs": {
    "url": "https://github.com/BindsHQ/stance/issues"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "packageManager": "npm@11.6.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "npm run build -w @bindshq/stance-tokens && npm run build -w @bindshq/stance-react",
    "build:docs": "npm run build -w @bindshq/stance-docs",
    "dev:docs": "npm run dev -w @bindshq/stance-docs",
    "test": "npm run test -w @bindshq/stance-tokens && npm run test -w @bindshq/stance-react",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:exports": "node scripts/check-exports.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build && changeset publish",
    "check:snippets": "npm run check:snippets -w @bindshq/stance-docs",
    "verify": "npm run format:check && npm run check:vercel && npm run tokens:check && npm run lint && npm run build && npm run typecheck && npm test && npm run check:exports && npm run check:consumer && npm run check:snippets && npm run build:docs && npm run check:seo",
    "audit:site": "node scripts/audit-site.mjs",
    "serve:docs": "node scripts/serve-static.mjs",
    "check:consumer": "tsc -p tests/consumer",
    "check:seo": "node scripts/check-seo.mjs",
    "build:brand": "node scripts/build-brand.mjs",
    "tokens": "npm run tokens -w @bindshq/stance-tokens",
    "tokens:check": "npm run tokens:check -w @bindshq/stance-tokens",
    "native:generate": "node scripts/generate-native.mjs",
    "check:react18": "node scripts/check-react18.mjs",
    "check:vercel": "node scripts/check-vercel.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.65.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2"
  }
}
