{
  "name": "@bindshq/stance-tokens",
  "version": "0.1.1",
  "description": "Design tokens for Stance, the Binds design system: colours, typography, spacing and three themes.",
  "license": "Apache-2.0",
  "author": "Binds",
  "homepage": "https://www.stanceui.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BindsHQ/stance.git",
    "directory": "packages/tokens"
  },
  "bugs": {
    "url": "https://github.com/BindsHQ/stance/issues"
  },
  "keywords": [
    "design-system",
    "design-tokens",
    "binds",
    "stance",
    "css-variables",
    "theming"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./css": "./dist/css/tokens.css",
    "./tokens.css": "./dist/css/tokens.css",
    "./tailwind": {
      "types": "./dist/tailwind.d.ts",
      "default": "./dist/tailwind.js"
    },
    "./tailwind-v4.css": "./dist/css/tailwind-v4.css",
    "./tokens.json": "./dist/tokens.json",
    "./contrast-report.json": "./dist/contrast-report.json",
    "./package.json": "./package.json",
    "./source/*": "./source/*",
    "./swift": "./generated/swift/StanceTokens.swift",
    "./kotlin": "./generated/kotlin/StanceTokens.kt",
    "./tokens.resolved.json": "./generated/json/tokens.resolved.json"
  },
  "files": [
    "dist",
    "source",
    "generated",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "node scripts/build-tokens.mjs && rm -rf dist && tsc -p tsconfig.build.json && node scripts/emit.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "tokens": "node scripts/build-tokens.mjs",
    "tokens:check": "node scripts/build-tokens.mjs --check"
  },
  "devDependencies": {
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
