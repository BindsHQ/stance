{
  "$description": "Light theme: a complete mapping of every semantic role.",
  "$extensions": {
    "com.bindshq.stance": {
      "name": "light",
      "label": "Light",
      "colorScheme": "light",
      "accent": "light"
    }
  },
  "color": {
    "$type": "color",
    "bg-canvas": {
      "$value": "{color.brand.ivory}"
    },
    "bg-subtle": {
      "$value": "{color.ink.25}"
    },
    "bg-muted": {
      "$value": "{color.ink.50}"
    },
    "bg-emphasis": {
      "$value": "{color.ink.100}"
    },
    "bg-surface": {
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 0.9882, 0.9647],
        "alpha": 1,
        "hex": "#FFFCF6"
      },
      "$extensions": {
        "com.bindshq.stance.derive": {
          "from": "light",
          "toward": "white",
          "amount": 0.55
        }
      }
    },
    "bg-surface-raised": {
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 0.9882, 0.9647],
        "alpha": 1,
        "hex": "#FFFCF6"
      },
      "$extensions": {
        "com.bindshq.stance.derive": {
          "from": "light",
          "toward": "white",
          "amount": 0.55
        }
      }
    },
    "bg-overlay": {
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 0.9882, 0.9647],
        "alpha": 1,
        "hex": "#FFFCF6"
      },
      "$extensions": {
        "com.bindshq.stance.derive": {
          "from": "light",
          "toward": "white",
          "amount": 0.55
        }
      }
    },
    "bg-inverse": {
      "$value": "{color.brand.indigo}"
    },
    "bg-scrim": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.0784, 0.0471, 0.1804],
        "alpha": 0.48,
        "hex": "#140C2E"
      },
      "$extensions": {
        "com.bindshq.stance.derive": {
          "from": "dark"
        }
      }
    },
    "fg-default": {
      "$value": "{color.brand.indigo}"
    },
    "fg-muted": {
      "$value": "{color.ink.600}"
    },
    "fg-subtle": {
      "$value": "{color.ink.500}"
    },
    "fg-disabled": {
      "$value": "{color.ink.300}"
    },
    "fg-inverse": {
      "$value": "{color.brand.ivory}"
    },
    "fg-link": {
      "$value": "{color.brand.indigo}",
      "$extensions": {
        "com.bindshq.stance.derive": {
          "accent": "text",
          "against": ["bg-canvas", "bg-surface", "bg-subtle"],
          "min": 4.5
        }
      }
    },
    "border-subtle": {
      "$value": "{color.ink.50}"
    },
    "border-default": {
      "$value": "{color.ink.100}"
    },
    "border-strong": {
      "$value": "{color.ink.200}"
    },
    "border-control": {
      "$value": "{color.ink.400}"
    },
    "border-control-hover": {
      "$value": "{color.ink.600}"
    },
    "separator": {
      "$value": "{color.ink.100}"
    },
    "accent-bg": {
      "$value": "{color.brand.indigo}",
      "$extensions": {
        "com.bindshq.stance.derive": {
          "accent": "fill",
          "min": 4.5
        }
      }
    },
    "accent-bg-hover": {
      "$value": "{color.ink.800}",
      "$extensions": {
        "com.bindshq.stance.derive": {
          "accent": "shade",
          "of": "accent-bg",
          "awayFrom": "accent-fg",
          "amount": 0.15
        }
      }
    },
    "accent-bg-active": {
      "$value": "{color.ink.700}",
      "$extensions": {
        "com.bindshq.stance.derive": {
          "accent": "shade",
          "of": "accent-bg",
          "awayFrom": "accent-fg",
          "amount": 0.3
        }
      }
    },
    "accent-fg": {
      "$value": "{color.brand.ivory}",
      "$extensions": {
        "com.bindshq.stance.derive": {
          "accent": "foreground",
          "on": "accent-bg"
        }
      }
    },
    "interactive-hover": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.0784, 0.0471, 0.1804],
        "alpha": 0.06,
        "hex": "#140C2E"
      },
      "$extensions": {
        "com.bindshq.stance.derive": {
          "from": "dark"
        }
      }
    },
    "interactive-active": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.0784, 0.0471, 0.1804],
        "alpha": 0.11,
        "hex": "#140C2E"
      },
      "$extensions": {
        "com.bindshq.stance.derive": {
          "from": "dark"
        }
      }
    },
    "interactive-selected": {
      "$value": "{color.ink.50}"
    },
    "interactive-selected-fg": {
      "$value": "{color.brand.indigo}",
      "$extensions": {
        "com.bindshq.stance.derive": {
          "accent": "text",
          "against": ["bg-canvas", "bg-surface", "bg-subtle", "interactive-selected"],
          "min": 4.5
        }
      }
    },
    "focus-ring": {
      "$value": "{color.brand.indigo}",
      "$extensions": {
        "com.bindshq.stance.derive": {
          "accent": "ring",
          "against": ["bg-canvas", "bg-surface", "focus-ring-offset"],
          "min": 3
        }
      }
    },
    "focus-ring-offset": {
      "$value": "{color.brand.ivory}"
