{
  "name": "@bindshq/stance-docs",
  "version": "0.1.1",
  "private": true,
  "description": "stanceui.com, documentation and landing page for Stance.",
  "license": "Apache-2.0",
  "author": "Binds",
  "homepage": "https://www.stanceui.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BindsHQ/stance.git",
    "directory": "apps/docs"
  },
  "bugs": {
    "url": "https://github.com/BindsHQ/stance/issues"
  },
  "type": "module",
  "scripts": {
    "generate": "node scripts/generate-registry.mjs && node scripts/generate-native-media.mjs",
    "dev": "npm run generate && next dev --port 3100",
    "build": "npm run generate && next build",
    "start": "next start --port 3100",
    "typecheck": "npm run generate && tsc --noEmit",
    "check:snippets": "npm run generate && node scripts/check-snippets.mjs"
  },
  "dependencies": {
    "@bindshq/stance-react": "0.1.1",
    "@bindshq/stance-tokens": "0.1.1",
    "next": "^16.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "sharp": "^0.35.5",
    "typescript": "~5.9.3"
  }
}
